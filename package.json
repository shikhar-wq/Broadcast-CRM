    "doc": "docs"
  },
  "scripts": {
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,green\" \"npm run server\" \"npm run client\"",
    "server": "tsx watch server/index.ts",
    "client": "npm --prefix client run dev",
    "build": "npm install && npm --prefix client install --include=dev && npm --prefix client run build",
    "start": "npx tsx server/index.ts"
  },
